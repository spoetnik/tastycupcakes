---
import type { GetStaticPaths } from "astro";
import ArchiveLayout from "../../../../layouts/ArchiveLayout.astro";
import ArticleList from "../../../../components/ArticleList.astro";
import Pagination from "../../../../components/Pagination.astro";
import { englishPosts, categories, categoryBySlug, paginate } from "../../../../utils/content";
import { SITE } from "../../../../utils/site";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await englishPosts();
  return categories.flatMap((c) => {
    const count = posts.filter((p) => p.data.categories.includes(c.slug)).length;
    const total = Math.ceil(count / SITE.postsPerPage);
    return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
      params: { slug: c.slug, page: String(i + 2) },
    }));
  });
};

const { slug, page: pageParam } = Astro.params;
const category = categoryBySlug.get(slug!)!;
const posts = (await englishPosts()).filter((p) => p.data.categories.includes(category.slug));
const page = paginate(posts, Number(pageParam), SITE.postsPerPage);
---
<ArchiveLayout
  title={`${category.name} — pagina ${page.current}`}
  heading={category.name}
  description={`${category.name}, pagina ${page.current} van ${page.total}.`}
  path={`/category/${category.slug}/page/${page.current}/`}
  intro={`Pagina ${page.current} van ${page.total}.`}
  trail={[{ href: `/category/${category.slug}/`, label: category.name }, { label: `Pagina ${page.current}` }]}
>
  <ArticleList posts={page.items} />
  <Pagination current={page.current} total={page.total} base={`/category/${category.slug}/`} />
</ArchiveLayout>
