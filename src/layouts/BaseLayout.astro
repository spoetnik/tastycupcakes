---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  path: string;
  type?: "website" | "article";
  image?: string | null;
  lang?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  alternates?: Array<{ lang: string; path: string }>;
  noindex?: boolean;
  /** JSON-LD; geen client-side JavaScript, alleen data voor zoekmachines. */
  schema?: unknown;
}
const { schema, ...props } = Astro.props;
---
<!doctype html>
<html lang={props.lang ?? "en"}>
  <head>
    <BaseHead {...props} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">Naar de inhoud</a>
    <Header />
    <main class="wrap" id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
