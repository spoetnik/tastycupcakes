---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Props {
  title: string;
  heading: string;
  description?: string;
  path: string;
  intro?: string;
  trail?: Array<{ href?: string; label: string }>;
  noindex?: boolean;
}
const { title, heading, description, path, intro, trail = [], noindex } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} noindex={noindex}>
  {trail.length > 0 && <Breadcrumbs trail={trail} />}
  <h1>{heading}</h1>
  {intro && <p class="prose">{intro}</p>}
  <slot />
</BaseLayout>
